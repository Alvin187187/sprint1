# ---------------------------------------------------------------------------
# Advisor Console — backend environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
ADVISOR_ID=career-transition
APP_TIMEZONE=Asia/Manila
CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string, then swap in your
# DB password. Port 5432 on the pooler host is session mode — the right choice
# for a long-lived uvicorn process. Port 6543 is transaction mode; it also works
# because app/db.py disables prepared statements, but it buys you nothing here.
#
# Shape (both <ref> and <region> appear in the string Supabase shows you):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Percent-encode the password if it contains @ : / # or ? — otherwise it breaks
# the DSN and the failure looks like a wrong password.
DATABASE_URL=

# --- Model provider -------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini
MODEL_TEMPERATURE=0.4
MAX_OUTPUT_TOKENS=900
REQUEST_TIMEOUT_SECONDS=60
MAX_HISTORY_TURNS=12

# --- Prompt / grounding control plane -------------------------------------
# local       → reads ../content/prompt.md and ../content/grounding.md
# google_docs → reads the two Doc IDs below via a service account
DOC_PROVIDER=local
DOC_CACHE_TTL_SECONDS=300
DOC_ROOT=../content

# Only needed when DOC_PROVIDER=google_docs.
# Share both Docs with the service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
PROMPT_DOC_ID=
GROUNDING_DOC_ID=

# --- Grounding retrieval --------------------------------------------------
GROUNDING_MAX_CHUNKS=3
GROUNDING_MAX_CHARS=2600
# Quality threshold, not a security boundary. Measured with
# scripts/tune_threshold.py — see docs/ARCHITECTURE.md §Retrieval.
GROUNDING_MIN_SCORE=0.08

# --- Guardrails -----------------------------------------------------------
# Rationale for these defaults is documented in docs/ARCHITECTURE.md §Caps.
DEFAULT_DAILY_MESSAGE_CAP=40
DEFAULT_DAILY_TOKEN_CAP=60000
DEFAULT_DAILY_SPEND_CAP_USD=0.50
RATE_LIMIT_PER_WINDOW=6
RATE_LIMIT_WINDOW_SECONDS=60

# --- Sessions -------------------------------------------------------------
SESSION_TTL_HOURS=720
SESSION_COOKIE_SECURE=false
# Comma-separated emails granted admin access in addition to role='admin'.
ADMIN_EMAILS=
